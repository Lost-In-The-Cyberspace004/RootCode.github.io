Algoritmo CalculadoraAnios
	
	definir AnioActual como real
	definir AnioDeNacimiento como real
	
	definir Calculos como real
	
	escribir "Anio Actual: "
	leer AnioActual
	
	escribir "Anio de nacimiento: "
	leer AnioDeNacimiento
	
	Calculos <- AnioActual - AnioDeNacimiento
	Escribir "Edad: " Calculos
	
FinAlgoritmo
