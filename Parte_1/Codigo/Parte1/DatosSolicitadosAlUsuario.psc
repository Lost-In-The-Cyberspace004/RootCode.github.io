Algoritmo DatosSolicitadosAlUsuario
	
	definir Nombre como cadena
	definir Edad como entero
	definir Ciudad como cadena
	
	escribir "Ingresa tu nombre: "
	leer Nombre
	
	escribir "Ingresa tu edad: "
	leer Edad
	
	escribir "Ingresar ciudad: "
	leer Ciudad
	
	escribir "Hola ", Nombre, " tienes: ", Edad, " años de edad y vives en: ", Ciudad
	
FinAlgoritmo